# LIVE COMMAND UPLINK: copy to .env.local and fill in. Never commit the real file.
# Create a key at https://cursor.com/dashboard → API Keys (user key or service account key).
# Read server-side only by the Vite dev/preview bridge (plugins/cursorAgentsApi.ts); never sent to the browser.
CURSOR_API_KEY=

# Optional: which Cursor Cloud Agents API surface the bridge uses. v0 (default, legacy, full transcripts) or v1 (current, runs-based).
# CURSOR_API_VERSION=v0

# Optional: override the API host (testing only).
# CURSOR_API_BASE=https://api.cursor.com
