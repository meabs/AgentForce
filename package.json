{
  "name": "agent-fleet-command",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cursor:status": "node scripts/write-cursor-status.mjs",
    "cursor:push": "node scripts/write-cursor-status.mjs",
    "cursor:watch": "node scripts/auto-sync-cursor.mjs",
    "cursor:sync": "node scripts/auto-sync-cursor.mjs --once",
    "build:demo": "tsc -b && VITE_STATIC_DEMO=1 vite build --outDir dist-demo && node -e \"require('fs').rmSync('dist-demo/cursor-live.json',{force:true})\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
